  "rulings": [
    {
      "id": "implement-tdd-seam-and-review",
      "owner": "engineering-principles",
      "document": "skills/engineering-principles/references/tdd/tdd.md",
      "section": "Seams: where tests go",
      "sources": [
        "tdd"
      ],
      "decision": "Approved source-artifact Test Seams count as pre-agreed. Ask only for missing, ambiguous or invalidated seams. Use host-supported named skill loading for optional Codebase Design vocabulary and Atlas Review for refactoring review; Tracking retains its acceptance gate."
    },
    {
      "id": "implement-source-receipts",
      "owner": "engineering-principles",
      "document": "skills/engineering-principles/references/source-driven/source-driven.md",
      "section": "Step 4: Cite Your Sources",
      "sources": [
        "source-driven-development"
      ],
      "decision": "Preserve official-doc evidence and retrieval hygiene within the bundled method. Source receipts belong in execution evidence and handoff; comments preserve enduring non-obvious code contracts rather than routine citations. Ordinary documentation retrieval does not require the external security-and-hardening skill."
    },
    {
      "id": "implement-architect-phases",
      "owner": "engineering-principles",
      "document": "skills/engineering-principles/references/architect/integration.md",
      "section": "Sketches and TDD",
      "sources": [
        "pstack-architect",
        "pstack-arena",
        "tdd",
        "source-driven-development",
        "pstack-principle-foundational-thinking",
        "pstack-principle-outcome-oriented-execution"
      ],
      "decision": "Architect is a selected design-first method, not a mandatory prelude to implementation. Respect design-only scope and opt-in checkpoints. Keep candidate stubs isolated, distinguish design validation from red/green behavior proof, and start selected TDD through the chosen agreed interface. Source-Driven supplies version-specific constraints. Existing verification and commit boundaries remain authoritative."
    },
    {
      "id": "implement-candidate-ownership",
      "owner": "engineering-principles",
      "document": "skills/engineering-principles/references/architect/integration.md",
      "section": "Candidate comparison and evidence",
      "sources": [
        "pstack-architect",
        "pstack-arena",
        "pstack-how",
        "pstack-why",
        "pstack-principle-exhaust-the-design-space",
        "pstack-principle-separate-before-serializing-shared-state"
      ],
      "decision": "Architect requires two structurally distinct candidates before synthesis even if generic Arena allows dropout or convergence. Candidate runners execute only their isolated sketch assignment, never recursively launch the workflow. Shared grounding sources load directly without the Explain chooser. Host limitations and actual reviewer independence are disclosed."
    },
    {
      "id": "implement-principle-scope",
      "owner": "engineering-principles",
      "document": "skills/engineering-principles/references/architect/integration.md",
      "section": "Candidate comparison and evidence",
      "sources": [
        "pstack-architect",
        "pstack-arena",
        "pstack-principle-boundary-discipline",
        "pstack-principle-fix-root-causes",
        "pstack-principle-prove-it-works"
      ],
      "decision": "Required principles are contextual bundled references within authorized scope. Internal trust depends on established invariants; legitimate guards and enduring comments remain. Direct outcome proof uses the agreed artifact and commit policy rather than activating an unselected external Show Me Your Work audit. Global principle-library and public Arena adoption remain independent decisions."
    }
  ],
