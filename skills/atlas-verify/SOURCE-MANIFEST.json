  "rulings": [
    {
      "id": "verify-executor-handoff",
      "owner": "atlas-verify",
      "document": "skills/atlas-verify/references/run.md",
      "section": "Handoffs",
      "sources": [
        "pe-verify"
      ],
      "decision": "Verification stays read-only toward product code. Return failures to the selected executor and quality or fidelity judgment to Atlas Review. A standalone report does not authorize implementation or acceptance."
    },
    {
      "id": "verify-qa-list-home",
      "owner": "atlas-verify",
      "document": "skills/atlas-verify/references/qa-list.md",
      "section": "Finding it",
      "sources": [
        "pe-verify"
      ],
      "decision": "Honor the user-selected QA list and repository convention; retain discovery context in an active Implementation Record. Replace Product Engineering global-memory reads and writes with project-local discovery."
    },
    {
      "id": "verify-browser-driver",
      "owner": "atlas-verify",
      "document": "skills/atlas-verify/references/evidence.md",
      "section": "Before driving anything",
      "sources": [
        "pe-verify"
      ],
      "decision": "Prefer agent-browser when available and able to produce the required video, timestamped checkpoints and stills. Use Playwright when that proof requires it. Missing browser coverage remains skipped with reasons."
    },
    {
      "id": "verify-method-authority",
      "owner": "atlas-verify",
      "document": "skills/atlas-verify/SKILL.md",
      "section": "Atlas Verify",
      "sources": [
        "pe-verify",
        "pstack-create-verification-skill",
        "pstack-maintain-verification-skill",
        "pstack-benchmark-checklist"
      ],
      "decision": "Select Run, Create, Maintain or Performance from the requested outcome. Product fixes remain outside verification. Run owns PE reporting; Create/Maintain own selected verifier assets, and standalone Performance owns measurement evidence. Missing local verifier assets do not add generator/maintenance work to a Run."
    },
    {
      "id": "verify-project-verifier-bridge",
      "owner": "atlas-verify",
      "document": "skills/atlas-verify/references/project-verifiers.md",
      "section": "Coverage and reporting",
      "sources": [
        "pe-verify",
        "pstack-create-verification-skill",
        "pstack-maintain-verification-skill"
      ],
      "decision": "Use reusable app-driving instructions without copying the report engine. Map requested features and entrypoints deliberately into PE feature/list reports, preserve prerequisites and lifecycle-versus-behavior states, reuse evidence, and keep one driver/cleanup owner per shared instance. Creation proves one seeded feature; maintenance accounts for every mapped feature."
    },
    {
      "id": "verify-performance-evidence",
      "owner": "atlas-verify",
      "document": "skills/atlas-verify/references/performance/benchmark-checklist.md",
      "section": "Report",
      "sources": [
        "pe-verify",
        "pstack-benchmark-checklist"
      ],
      "decision": "Vet actual measured claims with raw work/error/repetition/limiter evidence. Adapt host tools, keep optimization outside verification, and use existing schema fields when contributing to a Run; standalone benchmarks do not require a rendered PE report or external perf playbook."
    }
  ],
