  "rulings": [
    {
      "id": "team-up-method-selection",
      "owner": "team-up",
      "document": "skills/team-up/SKILL.md",
      "section": "Team Up",
      "sources": [
        "pstack-arena",
        "pstack-swarm"
      ],
      "decision": "Ordinary delegation and selection-only calls remain the default policy path. Arena owns candidate comparison/synthesis; Swarm owns partition/race/hybrid aggregation. Both use the shared selection reference directly without recursively selecting another workflow. Selected methods inherit the task write, evidence and delivery scope."
    },
    {
      "id": "team-up-swarm-evidence",
      "owner": "team-up",
      "document": "skills/team-up/references/swarm/swarm.md",
      "section": "Phase C: Aggregate",
      "sources": [
        "pstack-swarm"
      ],
      "decision": "Preserve declared race/coverage semantics and exact revision/measurement evidence. Bounded waves or sequential fallback do not claim unavailable concurrency. Retry evidence omissions once, keep dropouts and unproved slices as gaps, verify winning artifacts and account for every worker and its cleanup."
    },
    {
      "id": "team-up-arena-policy",
      "owner": "team-up",
      "document": "skills/team-up/references/arena/arena.md",
      "section": "Phase A: Frame",
      "sources": [
        "pstack-arena",
        "pstack-principle-separate-before-serializing-shared-state",
        "pstack-principle-laziness-protocol",
        "pstack-principle-redesign-from-first-principles",
        "pstack-principle-prove-it-works"
      ],
      "decision": "Share the maintained Arena method and complete four-principle closure with Architect while preserving caller-specific minimums and proof criteria. Selection uses Team Up policy only; actual candidate/judge models and independence gaps are reported. No external audit workflow is activated."
    }
