  "rulings": [
    {
      "id": "explain-mode-choice",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/SKILL.md",
      "section": "Atlas Explain",
      "sources": [
        "pstack-how",
        "pstack-why",
        "pstack-teach"
      ],
      "decision": "An omitted mode requires a brief How/Why/Teach chooser and a user answer before method loading or investigation. Honor explicit mode choices and reuse them for follow-ups. Teach calls bundled methods directly so internal dispatch does not repeat the chooser."
    },
    {
      "id": "explain-why-scope",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/references/teach/teach.md",
      "section": "Teach",
      "sources": [
        "pstack-why",
        "pstack-teach"
      ],
      "decision": "Standalone Why defaults to its full available evidence-category investigation. Teach may bound Why to its stated question and selected sources; exclusions are recorded as outside scope, distinct from unavailable or searched-empty categories, and limit conclusions."
    },
    {
      "id": "explain-evidence-editing",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/references/teach/teach.md",
      "section": "Teach",
      "sources": [
        "pstack-why",
        "pstack-teach",
        "pstack-unslop"
      ],
      "decision": "Teach owns pacing and conversational synthesis. Preserve Why confidence, uncertainty, citations, competing hypotheses and evidence gaps through Unslop edits; editorial cleanup cannot upgrade evidence strength. Unslop is only a bundled Teach dependency, not a global writing default."
    },
    {
      "id": "explain-host-capabilities",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/references/why/why.md",
      "section": "Why",
      "sources": [
        "pstack-how",
        "pstack-why"
      ],
      "decision": "Use host-available read capabilities, roles, models and bounded delegation rather than fixed Cursor/provider defaults. Missing history, connectors or delegation are disclosed gaps; investigation remains read-only and never invents availability."
    }
  ],
