  "rulings": [
    {
      "id": "explain-mode-choice",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/SKILL.md",
      "section": "Atlas Explain",
      "sources": [
        "pstack-how",
        "pstack-why",
        "pstack-teach",
        "explain-interface",
        "pstack-ketchup"
      ],
      "decision": "Select and combine methods from the request and conversation. Ask only when ambiguity materially changes the investigation or deliverable; offer options with a recommendation when the user asks to explore them. Teach supplies conversational pacing and coordinates How and Why. Catch Up is selected for requests about recent chat work and pending decisions. Reuse evidence across methods and adapt to follow-up questions."
    },
    {
      "id": "explain-evidence-editing",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/references/teach/teach.md",
      "section": "Teach",
      "sources": [
        "pstack-why",
        "pstack-teach",
        "pstack-unslop"
      ],
      "decision": "Teach and Unslop keep Why's citations, marked inferences and stated gaps. Teach uses the same maintained Unslop catalog as Writing for Humans, bundled locally without invoking the broader writing workflow."
    },
    {
      "id": "explain-host-capabilities",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/references/why/why.md",
      "section": "Why",
      "sources": [
        "pstack-how",
        "pstack-why"
      ],
      "decision": "How and Why use the host's available subagent tools and read access. Why says what it could not reach, and both stay read-only."
    },
    {
      "id": "explain-interface-evidence",
      "owner": "atlas-explain",
      "document": "skills/atlas-explain/references/interface/explain-interface.md",
      "section": "Measured, derived, inferred",
      "sources": [
        "explain-interface"
      ],
      "decision": "Interface explains observed mechanisms without a craft or accessibility verdict. Browser inspection stays read-only; a screenshot supports a qualified reconstruction, not proof of authored CSS, framework identity or accessibility conformance."
    }
  ],
