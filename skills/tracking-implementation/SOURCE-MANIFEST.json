  "rulings": [
    {
      "id": "tracking-show-me-handoff",
      "owner": "tracking-implementation",
      "document": "skills/tracking-implementation/SKILL.md",
      "section": "Artifact presentation",
      "sources": [
        "show-me"
      ],
      "decision": "Tracking sets HTML as the default for new local records, allows an explicitly requested alternative, and preserves existing formats unless conversion is requested. Load Show Me before creating or updating the tracking artifact to guide layout and representations within that format, preserving complete evidence, structured state and the existing acceptance contract."
    },
    {
      "id": "tracking-audit-trail-ownership",
      "owner": "tracking-implementation",
      "document": "skills/tracking-implementation/SKILL.md",
      "section": "Optional Audit Trail",
      "sources": [
        "pstack-show-me-your-work",
        "show-me"
      ],
      "decision": "Audit Trail activates on explicit request or resume of a selected trail. Its append-only TSV is linked evidence attached to the single Tracking Home, not a second execution-state system. Show Me still owns presentation; Tracking retains commit, code-review, handoff and acceptance policy. Only selected Audit Trail adds an extra required tracking artifact."
    },
    {
      "id": "tracking-audit-trail-coverage",
      "owner": "tracking-implementation",
      "document": "skills/tracking-implementation/references/audit-trail/audit-trail.md",
      "section": "Cross-model review of the trail",
      "sources": [
        "pstack-show-me-your-work",
        "pstack-unslop",
        "pstack-principle-encode-lessons-in-structure"
      ],
      "decision": "Reconcile only the current run's stretches against its workspace-scoped transcript and evidence. Use a different-family read-only reviewer when available; report missing transcript access, independence or review as gaps without substituting self-review or unperformed No flags. Preserve append-only corrections and run ownership. Attention is recorded at checkpoint handoffs, not every progress reply; audit findings feed existing tracking state without a new acceptance gate."
    }
  ],
